{
  "name": "applydesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs workers/job-sync/job-sync.test.mjs",
    "jobs:sync": "node workers/job-sync/index.mjs",
    "jobs:watch": "node workers/hourly.mjs --loop",
    "test:browser": "playwright test",
    "jobs:check": "node workers/job-sync/index.mjs --dry-run",
    "cf:deploy:jobs": "npx wrangler deploy --config wrangler.job-sync.toml",
    "cf:tail:jobs": "npx wrangler tail applydesk-job-sync",
    "predev": "node scripts/prepare-document-worker.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.3",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "^3.9.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  }
}
