{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": { "@/*": ["desk-src/*"] }
  },
  "include": [
    "desk-src/main.tsx",
    "desk-src/admin-main.tsx",
    "desk-src/Workspace.tsx",
    "desk-src/Login.tsx",
    "desk-src/lib/**/*.ts",
    "vite.config.ts"
  ]
}
