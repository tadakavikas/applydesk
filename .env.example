# Copy to .env.local and fill values. Never commit real keys.
# Share real keys via a password manager, not chat.

SUPABASE_URL=https://rofyegirmgqjhekuxjat.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional later: tailoring
ANTHROPIC_API_KEY=

# Submission worker. Keep false until dry-run fill is proven.
ALLOW_LIVE_SUBMIT=false

# Hourly loop (ms). 3600000 = 1 hour.
JOB_SYNC_INTERVAL_MS=3600000

# Server-only shared secret for the Cloudflare job-sync Worker (32+ random characters).
# Generate with: openssl rand -hex 32
JOB_SYNC_SECRET=
